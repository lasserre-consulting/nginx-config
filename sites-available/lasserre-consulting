# Détection de la langue pour le site vitrine
map $http_accept_language $lang_redirect {
    default  "fr";
    ~*^en    "en";
    ~*^fr    "fr";
}

# ── Redirection HTTP → HTTPS ───────────────────────────────────────────────
server {
    listen 80;
    server_name lasserre-consulting.fr www.lasserre-consulting.fr;
    return 301 https://$host$request_uri;
}

# ── HTTPS ──────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    server_name lasserre-consulting.fr www.lasserre-consulting.fr;

    ssl_certificate /etc/letsencrypt/live/lasserre-consulting.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lasserre-consulting.fr/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header X-Frame-Options           "SAMEORIGIN"                        always;
    add_header X-Content-Type-Options    "nosniff"                           always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Referrer-Policy           "no-referrer-when-downgrade"        always;

    # ===== ATELIER DU FIL =====
    location = /atelier-du-fil {
        return 301 https://$host/atelier-du-fil/;
    }

    location /atelier-du-fil/api/auth/ {
        limit_req zone=atelier_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:3004/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /atelier-du-fil/api/ {
        limit_req zone=atelier_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:3004/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25M;
    }

    location /atelier-du-fil/ {
        proxy_pass http://127.0.0.1:4203/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ===== SITE VITRINE — image profil (priorité sur le bloc /images/ d'Atelier du Fil) =====
    location = /images/profil.png {
        root /var/www/lasserre-consulting-site/fr;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ===== ATELIER DU FIL — assets racine (temporaire sous-chemin) =====
    location /images/ {
        proxy_pass http://127.0.0.1:4203/images/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=86400";
    }


    # ===== CARNETROUTE =====
    location = /carnetroute {
        return 301 https://$host/carnetroute/;
    }

    location /carnetroute/ {

        proxy_pass http://127.0.0.1:4202/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /carnetroute/api/ {
        proxy_pass http://localhost:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /ws/ {
        proxy_pass http://localhost:8080/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # ===== MISSION TRACKER =====
    location = /mission-tracker {
        return 301 https://$host/mission-tracker/;
    }

    location /mission-tracker/ {

        proxy_pass http://127.0.0.1:4201/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /mission-tracker/api/ {
        proxy_pass http://localhost:8081/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    # ===== LEGACODE =====
    location = /legacode {
        return 302 https://$host/legacode/fr;
    }

    location = /legacode/ {
        return 302 https://$host/legacode/fr;
    }

    location /legacode/api/ {
        proxy_pass http://127.0.0.1:8082/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 500M;
    }

    location /legacode/ {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ===== SITE VITRINE =====
    # Redirection racine selon la langue du navigateur
    location = / {
        return 302 https://$host/$lang_redirect/;
    }

    # Locale française
    location /fr/ {
        alias /var/www/lasserre-consulting-site/fr/;
        index index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri $uri/ /fr/index.html;
    }

    # Locale anglaise
    location /en/ {
        alias /var/www/lasserre-consulting-site/en/;
        index index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri $uri/ /en/index.html;
    }

    # Assets racine générés par Angular (manifest, favicon, etc.)
    location / {
        root /var/www/lasserre-consulting-site/fr;
        try_files $uri =404;
    }
}
